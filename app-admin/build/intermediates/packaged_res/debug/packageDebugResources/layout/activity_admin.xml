        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_research"/>
            </FrameLayout>

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="장소 검색"
                android:textColor="@color/black"
                android:background="@null"
                android:paddingStart="12dp"/>

            <FrameLayout
                android:id="@+id/Voice_research"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mic"/>
            </FrameLayout>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 하단 BottomSheet -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_nav"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="120dp"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.5"
        android:elevation="20dp">

        <!-- handle -->
        <View
            android:id="@+id/handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:background="#C2C6D6"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/handle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_View"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <!-- 가게 이름 -->
                <TextView
                    android:id="@+id/txt_store_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시흥 베이커리"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- 태그 -->
                <TextView
                    android:id="@+id/txt_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_tag_red"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="지역화폐 사용 불가능"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/txt_store_name"
                    app:layout_constraintStart_toEndOf="@id/txt_store_name" />

                <!-- 찜 -->
                <ImageView
                    android:id="@+id/btn_heart"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_heart_outline"
                    app:layout_constraintTop_toTopOf="@id/txt_store_name"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 카테고리 -->
                <TextView
                    android:id="@+id/txt_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="제과/디저트"
                    android:textSize="18sp"
                    app:layout_constraintTop_toBottomOf="@id/txt_store_name"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- 길찾기 -->
                <LinearLayout
                    android:id="@+id/btn_direction"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_balance_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/txt_category"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_share">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="길찾기"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 공유 -->
                <ImageButton
                    android:id="@+id/btn_share"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_noprofile_section"
                    android:src="@drawable/ic_share"
                    app:layout_constraintTop_toTopOf="@id/btn_direction"
                    app:layout_constraintBottom_toBottomOf="@id/btn_direction"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 전화 -->
                <ImageView
                    android:id="@+id/ic_phone"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="32dp"
                    android:src="@drawable/ic_phone"
                    app:layout_constraintTop_toBottomOf="@id/btn_direction"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txt_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="031-123-4567"
                    android:textColor="@color/text3"
                    app:layout_constraintTop_toTopOf="@id/ic_phone"
                    app:layout_constraintStart_toEndOf="@id/ic_phone"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 주소 -->
                <ImageView
                    android:id="@+id/ic_location"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_location"
                    app:layout_constraintTop_toBottomOf="@id/ic_phone"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txt_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="경기도 시흥시 배곧동..."
                    android:textColor="@color/text3"
                    app:layout_constraintTop_toTopOf="@id/ic_location"
                    app:layout_constraintStart_toEndOf="@id/ic_location"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 시간 -->
                <ImageView
                    android:id="@+id/ic_time"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_time"
                    app:layout_constraintTop_toBottomOf="@id/ic_location"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/txt_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="영업 중"
                    android:textColor="@color/text3"
                    app:layout_constraintTop_toTopOf="@id/ic_time"
                    app:layout_constraintStart_toEndOf="@id/ic_time"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>