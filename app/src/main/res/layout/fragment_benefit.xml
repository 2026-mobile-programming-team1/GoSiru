<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="40dp"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/benefit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:padding="30dp">

        <!-- 상단 제목 -->
        <LinearLayout
            android:id="@+id/CustomBenefitHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvBenefitheader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="맞춤형 지역 혜택"
                android:fontFamily="@font/pretendard"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text3" />

        </LinearLayout>

        <!-- 프로필 미작성자 안내 영역 -->
        <LinearLayout
            android:id="@+id/sectionProfileEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp"
            android:gravity="center"
            android:background="@drawable/bg_noprofile_section"
            app:layout_constraintTop_toBottomOf="@id/CustomBenefitHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">

            <ImageView
                android:id="@+id/NoProfileIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_no_profile_icon"
                android:src="@drawable/ic_noprofile" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:text="혜택 정보 제공을 위해선\n프로필을 먼저 작성해 주세요"
                android:fontFamily="@font/pretendard"
                android:textColor="@color/text3" />

            <TextView
                android:id="@+id/BtnOpenProfileEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="프로필 작성하기"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="50dp"
                android:paddingEnd="50dp"
                android:background="@drawable/bg_btn_open_profile_edit"
                android:fontFamily="@font/pretendard"
                android:textColor="@color/text2" />

        </LinearLayout>

        <!-- 프로필 작성자 혜택 리스트 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sectionProfileDone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/CustomBenefitHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWelfareList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="40dp"
                android:text="조건에 맞는 혜택이 없어요"
                android:textColor="@color/text3"
                android:fontFamily="@font/pretendard"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 하단 네비게이션에 마지막 카드가 가려지지 않도록 여백 확보 -->
        <View
            android:id="@+id/bottomSpacer"
            android:layout_width="0dp"
            android:layout_height="220dp"
            app:layout_constraintTop_toBottomOf="@id/sectionProfileDone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>