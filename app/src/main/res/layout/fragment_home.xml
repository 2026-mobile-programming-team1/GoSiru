<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none"
    android:paddingBottom="100dp"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:padding="30dp">

        <LinearLayout
            android:id="@+id/cardBalance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="25dp"
            android:paddingRight="25dp"
            android:paddingBottom="25dp"
            android:paddingTop="30dp"
            android:background="@drawable/bg_balance_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvBalanceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="보유 잔액"
                android:textColor="@color/text2"
                android:alpha="0.8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBalanceAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123,456"
                    android:textColor="@color/text2"
                    android:textStyle="bold"
                    android:textSize="30sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvBalanceUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="원"
                    android:textColor="@color/text2"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnOpenApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_botton1"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_wallet"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="지역 화폐 결제 앱 이동"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:fontFamily="@font/pretendard"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sectionBenefit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:padding="20dp"
            android:gravity="center"
            android:background="@drawable/bg_benefit_background"
            app:layout_constraintTop_toBottomOf="@id/cardBalance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/benefitLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/BenefitIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:background="@drawable/bg_benefit_icon"
                    android:src="@drawable/ic_benefit"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:id="@+id/BenefitAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvBenefitTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이번 달 누적 혜택"
                        android:fontFamily="@font/pretendard"
                        android:textSize="15sp"
                        android:textColor="@color/text3"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:id="@+id/tvBenefitAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+123,456원"
                        android:fontFamily="@font/pretendard"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/benefit" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnBenefitDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="@drawable/bg_benefit_detail"
                android:text="내역 보기"
                android:textColor="@color/benefit"
                android:fontFamily="@font/pretendard"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHighlightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026 하이라이트"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#191F28"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/sectionBenefit"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:id="@+id/layoutHighlightCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvHighlightTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/btnNewPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_white_rounded2"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_badge_blue" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_my_calendar"
                        app:tint="#3182F6" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026 신규 정책"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#191F28"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="올해 새로 생긴 복지 혜택을 확인하세요"
                        android:textSize="12sp"
                        android:textColor="#8B95A1"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="#B0B8C1"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnIncreasedPolicy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_white_rounded2"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_badge_orange" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:tint="#FF8500" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="인상된 지원금"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#191F28"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="지원 금액이 늘어난 복지 혜택을 확인하세요"
                        android:textSize="12sp"
                        android:textColor="#8B95A1"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="#B0B8C1"/>
            </LinearLayout>
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:layout_constraintTop_toBottomOf="@id/layoutHighlightCards"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>